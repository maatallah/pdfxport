{
  "manifest_version": 3,
  "name": "PDF Interceptor Pro",
  "version": "3.0",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://app.decoloop.com/*",
    "https://sievalhub.sieval.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.decoloop.com/*"
      ],
      "js": [
        "content_main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject_xhr.js",
        "inject_fetch.js",
        "inject_blob.js"
      ],
      "matches": [
        "https://app.decoloop.com/*"
      ]
    }
  ]
}